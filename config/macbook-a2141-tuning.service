[Unit]
Description=MacBook Pro A2141 Dynamic Thermal, Power, GPU and Memory Tuning Daemon
After=multi-user.target thermald.service power-profiles-daemon.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/macbook-a2141-tuning-daemon.sh
Restart=always
RestartSec=3s
KillMode=process

[Install]
WantedBy=multi-user.target
